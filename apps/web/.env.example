# De dónde salen el catálogo y los pagos:
#   api  = backend apps/api (catálogo, 402, token de 24 h; el pago aún es simulado en el API, ver #32)
#   mock = todo en el navegador, sin API (respaldo si el backend se cae en la demo)
NEXT_PUBLIC_DATA_SOURCE=api

# URL del backend cuando NEXT_PUBLIC_DATA_SOURCE=api
NEXT_PUBLIC_API_URL=http://localhost:4000

# mock = wallet simulada, sin extensión · freighter = conexión real con Freighter (valida Testnet)
NEXT_PUBLIC_WALLET=mock
