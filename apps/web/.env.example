# De dónde salen el catálogo y los pagos:
#   api  = backend apps/api (catálogo, 402, token de 24 h)
#   mock = todo en el navegador, sin API (respaldo si el backend se cae en la demo)
NEXT_PUBLIC_DATA_SOURCE=api

# Backend al que Next reenvía /api/* (proxy en next.config.ts; se lee al compilar).
# El navegador solo habla con el dominio del frontend, así que CORS no aplica.
# Para el backend local: http://localhost:4000
API_PROXY_TARGET=https://paperpay-backend-production.up.railway.app

# Wallet: mock = simulada · freighter = extensión real (v1) · pollar = login social (v2, en construcción)
# También se puede forzar por URL: ?wallet=freighter | ?wallet=mock | ?wallet=pollar
NEXT_PUBLIC_WALLET=freighter

# v2 (Pollar): publishable key de testnet del dashboard de Pollar. Sin esta key, el modo
# pollar no se activa aunque NEXT_PUBLIC_WALLET=pollar (el provider no se monta).
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
