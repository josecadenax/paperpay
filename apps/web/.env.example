# Mientras el backend no esté listo, el catálogo y los pagos se simulan en el navegador
# (src/services/paperpay.ts). Esta variable solo elige la wallet:
# mock = wallet simulada, no necesita extensión (recomendado para la demo)
# freighter = extensión Freighter real (conexión y validación de red; el pago sigue simulado)
NEXT_PUBLIC_WALLET=mock
