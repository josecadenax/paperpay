PORT=4000
NODE_ENV=development

# Sustituye por una cuenta G... de Stellar Testnet antes de liquidar pagos.
STELLAR_TREASURY_PUBLIC_KEY=GB6X402TREASURYDEMOUNAM2026GOYAHACKPAPERPAYTESTNET

# Solo para una demo local. En producción siempre se desactiva.
DEMO_PAYMENTS=false

# true: envía a Horizon una transacción clásica ya firmada por el lector.
SELF_SETTLE=false

# Integración externa aún sin prueba de liquidación real.
OPENZEPPELIN_CHANNELS_URL=https://channels.openzeppelin.com/x402/testnet
OPENZEPPELIN_API_KEY=

# Sustituye por un valor aleatorio largo. Es obligatorio en producción.
JWT_SECRET=replace-with-a-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
