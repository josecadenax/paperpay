{
  "name": "paperpay-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "dev:api": "pnpm --filter @paperpay/api dev",
    "dev:web": "pnpm --filter @paperpay/web dev",
    "build:api": "pnpm --filter @paperpay/api build",
    "build:shared": "pnpm --filter @paperpay/shared build",
    "test": "pnpm --filter @paperpay/api test"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
